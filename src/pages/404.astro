---
import Layout from "@components/Layout.astro";
import ExploreMore from "@components/ExploreMore.astro";
import { Icon } from "astro-icon/components";
---

<Layout
  title="Página no encontrada"
  description="La página que buscas no existe"
>
  <div class="max-w-8xl mx-auto py-12 px-4">
    <div class="text-center mb-12">
      <div class="mb-8">
        <span class="text-8xl font-bold text-emerald-800">404</span>
      </div>

      <h1 class="text-3xl font-bold text-emerald-800 mb-4">
        Te has perdido en el bosque
      </h1>

      <p class="text-lg text-gray-700 mb-2 max-w-2xl mx-auto">
        La página que buscas no existe o ha sido movida.
      </p>

      <p class="text-gray-600 mb-8 max-w-2xl mx-auto">
        Como las sendas del Faedo, algunos caminos llevan a lugares inesperados.
        Vuelve al inicio o explora las rutas principales.
      </p>

      <div class="flex flex-wrap gap-4 justify-center mb-16">
        <a
          href="/"
          class="inline-flex items-center px-6 py-3 bg-emerald-700 text-white rounded-lg hover:bg-emerald-800 transition-colors font-medium"
        >
          <Icon name="ph:house" class="mr-2 h-5 w-5" aria-hidden="true" />
          Volver al inicio
        </a>

        <a
          href="/ruta/faedo-de-cinera"
          class="inline-flex items-center px-6 py-3 border-2 border-emerald-700 text-emerald-700 rounded-lg hover:bg-emerald-50 transition-colors font-medium"
        >
          <Icon name="ph:map-trifold" class="mr-2 h-5 w-5" aria-hidden="true" />
          Ver la ruta
        </a>
      </div>
    </div>

    <div class="border-t border-gray-200 pt-10">
      <h2 class="text-2xl font-semibold text-emerald-800 mb-8 text-center">
        Páginas que podrían interesarte
      </h2>
      <ExploreMore variant="grid" titleTag="h3" />
    </div>
  </div>
</Layout>
