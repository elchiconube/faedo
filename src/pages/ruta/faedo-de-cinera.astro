---
import Layout from "@components/Layout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import MapLeaflet from "@components/MapLeaflet.astro";
import Seo from "@components/Seo.astro";
import coverImage from "@assets/faedo-de-cinera.webp";
import Gallery from "@components/Gallery.astro";
import ExploreMore from "@components/ExploreMore.astro";
import CalloutLink from "@components/CalloutLink.astro";
import PromoLienzo from "@components/PromoLienzo.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import imageBocamina from "@assets/bocamina.webp";
import imagePuente from "@assets/puente.webp";
import imageMarmitas from "@assets/marmitas-2.webp";
import imagePozoIbarra2 from "@assets/pozo-ibarra-2.webp";
import imageFagus from "@assets/fagus.webp";

const data = {
  title: "Ruta del Faedo de Ciñera",
  summary:
    "Sendero fácil por el hayedo del Faedo de Ciñera (León), ideal para familias y en otoño. Incluye mapa, GPX y consejos prácticos.",
  distance_km: 4.5,
  elevation_m: 120,
  duration_h: 1.5,
  difficulty: "fácil",
  season: "Todo el año (mejor en otoño y primavera)",
  start_coords: {
    lat: 42.8205,
    lng: -5.6335,
  },
  gpx_url: "https://faedo.es/gpx/faedo.gpx",
  access:
    "Desde León, A-66 dirección Oviedo, salida La Robla/Ciñera. En bus (ALSA) hasta Ciñera; tren FEVE hasta La Robla y taxi.",
  parking: "Aparcamiento señalizado en Ciñera, junto al inicio de la ruta.",
  family_friendly: true,
  tags: ["senderismo", "León", "hayedo", "otoño", "con niños", "fácil"],
  coverImage: coverImage,
};

const hikingTrailLd = {
  "@type": "HikingTrail",
  name: data.title,
  description: data.summary,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  image: data.coverImage.src,
  trailLength: { "@type": "Distance", name: `${data.distance_km} km` },
  estimatedDuration: `PT${Math.round(data.duration_h)}H`,
  difficulty: data.difficulty,
  geo: {
    "@type": "GeoCoordinates",
    latitude: data.start_coords.lat,
    longitude: data.start_coords.lng,
  },
};

const attractionLd = {
  "@type": "TouristAttraction",
  name: "Faedo de Ciñera",
  description: data.summary,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  image: data.coverImage.src,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Ciñera",
    addressRegion: "León",
    addressCountry: "ES",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: data.start_coords.lat,
    longitude: data.start_coords.lng,
  },
};
---

<Layout title={`La Ruta: ${data.title}`} description={data.summary}>
  <Seo
    slot="head"
    title={`La ruta: ${data.title}`}
    description={data.summary}
    type="place"
    jsonLd={[hikingTrailLd, attractionLd]}
  />
  <Breadcrumbs
    items={[
      { href: "/", label: "Inicio" },
      { href: "/ruta/faedo-de-cinera", label: "La Ruta" },
    ]}
  />

  <article>
    <header class="text-center max-w-2xl mx-auto mt-5">
      <h1 class="mb-2 text-emerald-800 text-balance">
        Ruta del Faedo de Ciñera
      </h1>
      <p>
        El Faedo de Ciñera es un hayedo centenario en León con senderismo fácil
        ideal para familias.
      </p>
    </header>
<CalloutLink href="/guia-visitantes" subtitle="Rutas, preparativos y servicios del pueblo">
  Ver Guía para Visitantes
</CalloutLink>
    <section aria-labelledby="mapa" class="max-w-7xl mx-auto px-4">
      <MapLeaflet
        lat={data.start_coords.lat}
        lng={data.start_coords.lng}
        zoom={14}
        height="380px"
      />
      <p class="text-sm">
        Descarga el GPX: <a href="/gpx/faedo.gpx" download>faedo.gpx</a>
      </p>
    </section>
    <aside class="grid sm:grid-cols-3 gap-4 max-w-7xl mx-auto py-8 px-4">
<div class="min-h-[200px] border border-neutral-400 rounded-lg p-4 flex flex-col justify-between">
  <div class="mb-4 text-center">
    <span class="inline-block text-emerald-300 mb-2">
      <Icon name="ph:signpost" class="h-8 w-8" aria-hidden="true" />
    </span>
    <h3 class="text-2xl text-emerald-800">Cómo llegar y empezar tu ruta</h3>
  </div>

  <p class="mb-3">
    <ul>
      <li>En coche por la N630 dirección Oviedo.</li>
      <li>En autobus ALSA desde León hasta Ciñera,</li>
    </ul>
    </p>
  <p>
    En Ciñera, encontrarás <strong>aparcamiento </strong>
    <a href="https://maps.app.goo.gl/SdQxtZvE2ud87h938" target="_blank" rel="noopener noreferrer">
      al inicio de la ruta
    </a>
  </p>
</div>


      <div class="min-h-[200px] border border-neutral-400 rounded-lg p-4">
        <div class="mb-4 text-center">
          <span class="inline-block text-emerald-300">
            <Icon name="ph:garage" class="h-8 w-8" aria-hidden="true" />
          </span>
          <h3 class="text-2xl text-emerald-800">Dónde aparcar</h3>
        </div>
        <ul>
          <li>
            <a
              href="https://maps.app.goo.gl/qbqp7HGWuW4A6T2Z7"
              target="_blank"
              rel="noopener noreferrer">Campo de fútbol</a
            >
          </li>
          <li>
            <a
              href="https://maps.app.goo.gl/a4fEvAas4gp5V6dT7"
              target="_blank"
              rel="noopener noreferrer">Bolera</a
            >
          </li>
          <li>
            <a
              href="https://maps.app.goo.gl/iGxsmdMxtnaBsDecA"
              target="_blank"
              rel="noopener noreferrer">Calle principal</a
            >
          </li>
          <li>
            <a
              href="https://maps.app.goo.gl/DngiLUueFj7EnYqo8"
              target="_blank"
              rel="noopener noreferrer">Casa de la Cultura</a
            >
          </li>
        </ul>
      </div>
      <div class="min-h-[200px] border border-neutral-400 rounded-lg p-4">
        <div class="mb-4 text-center">
          <span class="inline-block text-emerald-300">
            <Icon name="ph:map-pin" class="h-8 w-8" aria-hidden="true" />
          </span>
          <h3 class="text-2xl text-emerald-800">Zonas de interés</h3>
        </div>
        <ul>
          <li>
            <a
              href="https://maps.app.goo.gl/CNydGugH1VYSGBEfA"
              target="_blank"
              rel="noopener noreferrer">Zona de bares</a
            >
          </li>
          <li>
            <a
              href="https://maps.app.goo.gl/H7pgHyxRtLc8VKzNA"
              target="_blank"
              rel="noopener noreferrer">Farmacia</a
            >
          </li>
          <li>
            <a
              href="https://maps.app.goo.gl/RJH6qe6EgW6LSr63A"
              target="_blank"
              rel="noopener noreferrer">Supermercado</a
            >
          </li>
          <li>
            <a
              href="https://maps.app.goo.gl/CKuw7rJpNAViLjus5"
              target="_blank"
              rel="noopener noreferrer">Lavandería autoservicio</a
            >
          </li>
        </ul>
      </div>
    </aside>

    <div class="prose max-w-4xl mx-auto py-8 px-4">
      <h2>El Recorrido paso a paso</h2>
      <p>
        El <strong>Faedo de Ciñera</strong> es uno de esos lugares que no se visitan,
        se viven. Situado en la vertiente sur de la <strong
          >Cordillera Cantábrica</strong
        >, dentro de la <strong>Reserva de la Biosfera del Alto Bernesga</strong
        > (UNESCO, 2005), este pequeño hayedo ha sido reconocido como el <a href="/premio-2007/">Bosque mejor
        cuidado de España (2007)</a> y forma parte del alma de Ciñera
      </p>

      <p>
        La ruta, de unos <strong>5 kilómetros ida y vuelta</strong>, comienza en
        la <strong>plaza de la iglesia</strong>. Desde allí, el camino avanza
        dejando atrás la bolera y el cementerio, donde ya se siente el rumor del <strong
          >Arroyo Villar</strong
        >, guía natural de este recorrido. El sendero es cómodo y llano,{' '}
        <a href="https://faedo.es/blog/faedo-de-cinera-con-ninos/">adecuado para toda la familia</a>.
      </p>

      <p>
        A unos dos kilómetros del inicio, aparece la <a href="https://faedo.es/blog/bocamina-menos-cincuenta/">bocamina</a>,
        rehabilitada por los vecinos con un cariño que se nota en cada detalle.
        En su interior, convertida en museo, se conservan herramientas y
        recuerdos.
      </p>

      <Image
        class="w-full h-full rounded-2xl object-cover object-center my-8"
        src={imageBocamina}
        alt="Bocamina"
        loading="lazy"
      />

      <p>
        Un poco más adelante, el paisaje cambia. Se levanta la antigua <strong
          >escombrera</strong
        >, hoy restaurada y cubierta de vegetación. Desde allí, se alcanza el <strong
          >puente artesanal</strong
        > construido por algunos mineros del pueblo, que permite cruzar el arroyo
        para más adelante llegar a una zona de prado y calma: el <strong
          >merendero</strong
        >, con mesas de madera y sombra generosa, donde el aire huele a hierba
        recién cortada y a paz.
      </p>

      <Image
        class="w-full h-full rounded-2xl object-cover object-center my-8"
        src={imagePuente}
        alt="Puente artesanal hecho por mineros de l zona"
        loading="lazy"
      />

      <p>
        A medida que el sendero continúa, la luz se tamiza y el bosque empieza a
        abrazarte. Es la entrada al Faedo, un hayedo pequeño pero de belleza
        desbordante, donde cada árbol parece tener alma. Las hayas, crean un
        techo de hojas que cambia de color con las estaciones. En otoño, el
        bosque se tiñe de oro y cobre; en primavera, todo se vuelve verde y
        nuevo.
      </p>

      <p>
        Dentro del hayedo, los carteles hablan de leyendas de <a href="/blog/la-magia-del-faedo-de-cinera">hadas y brujas buenas</a>{' '}
        que habitan entre las raíces. Es fácil creerlo: el silencio es distinto,
        profundo, lleno de vida. En el corazón del bosque se encuentra <strong
          >Fagus</strong
        >, una haya de unos <a href="/haya-fagus">500 años</a> y más de <strong
          >6 metros de perímetro</strong
        >, considerada una de las 100 más singulares de España.
      </p>

      <Image
        class="w-full h-full rounded-2xl object-cover object-center my-8"
        src={imageFagus}
        alt="Fagus el Haya de 500 años"
        loading="lazy"
      />

      <p>
        Más allá, el camino se estrecha y se transforma en roca. El arroyo ha
        tallado durante siglos las Hoces del Villar, un desfiladero imponente
        que une Ciñera con <strong>Villar del Puerto</strong>. Una pasarela de
        madera y acero, construida en 2005, permite recorrer este tramo con
        seguridad, suspendidos sobre el agua. La vista desde aquí es pura
        emoción: cascadas, pozas y el sonido constante del agua entre las
        piedras, desde donde se pueden apreciar las <a href="blog/marmitas-de-gigante/">Marmitas de Gigante</a>, formaciones naturales creadas por la fuerza del arroyo al chocar
        contra la piedra caliza. En los días cálidos, el reflejo del sol sobre
        el agua convierte este rincón en un espectáculo de luz. Aquí muchos
        visitantes deciden detenerse y regresar por el mismo camino, aunque
        también es posible continuar hasta <strong>Valporquero</strong> o <strong
          >Villar del Puerto</strong
        >, siguiendo la senda que antaño recorrían los mineros.
      </p>

      <Image
        class="w-full h-full rounded-2xl object-cover object-center my-8"
        src={imageMarmitas}
        alt="Marmitas de Gigante"
        loading="lazy"
      />

      <p>
        De vuelta, el camino nos invita a mirar con otros ojos lo ya visto. En
        la zona de la escombrera, un desvío conduce al <strong
          >mirador del Beso</strong
        >, desde donde se puede contemplar el valle en toda su amplitud. Un poco
        más arriba, se levanta el castillete del <a href="/pozo-ibarra">Pozo Ibarra</a>,
        símbolo del pasado industrial de Ciñera. Este conjunto fue declarado en
        2011 <strong>Bien de Interés Cultural</strong> (BIC) con la categoría de{' '}
        <strong>Conjunto Etnográfico</strong>, en reconocimiento a su valor
        histórico y humano.
      </p>

      <Image
        class="w-full h-full rounded-2xl object-cover object-center my-8"
        src={imagePozoIbarra2}
        alt="Pozo Ibarra"
        loading="lazy"
      />

      <p>
        Desde allí, solo queda dejarse llevar cuesta abajo, hasta regresar a <strong
          >Ciñera</strong
        >, al punto donde comenzó el viaje.
      </p>

      <p>
        Y aunque el recorrido termine, el Faedo sigue contigo. Porque este
        bosque —pequeño, frágil y eterno— no solo se recorre con los pies, sino
        con el alma. Quien entra en él, siempre vuelve.
      </p>
    </div>
  </article>

  <Gallery />

  <PromoLienzo />
  <ExploreMore variant="interes" />
</Layout>
