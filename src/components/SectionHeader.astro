---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description?: string;
  icon?: string;
}

const {
  title,
  description,
  icon,
} = Astro.props;
---

<header class:list={["text-center max-w-2xl mx-auto", description ? "mb-10" : "mb-3"]}>
  {icon && <div class="inline-block rounded-full bg-emerald-100 p-4 text-emerald-700 mb-2">
    <Icon name={icon} class="h-8 w-8" aria-hidden="true" />
  </div>}
  <h2 class="text-3xl mb-2 text-emerald-800 text-balance">{title}</h2>
  {description && (
    <p class="text-balance text-emerald-800 font-medium leading-6">
      {description}
    </p>
  )}
</header>
