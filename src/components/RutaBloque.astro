---
interface Props {
  title: string;
}

const { title } = Astro.props;
const hasInfo = Astro.slots.has("info");
---

<article class="my-5 border-b border-primary-100 py-5">
  <h3
    class="mt-0 mb-6 text-center text-4xl font-semibold text-primary-700 text-balance"
  >
    {title}
  </h3>
  {
    hasInfo && (
      <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
        <slot name="info" />
      </div>
    )
  }
  <slot />
</article>
