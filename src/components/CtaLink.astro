---
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  title?: string;
  class?: string;
  target?: string;
  rel?: string;
  /** Fuerza estilo externo; por defecto se infiere del href */
  external?: boolean;
  /** Centra el CTA con margen vertical (páginas de contenido) */
  centered?: boolean;
  eventName?: string;
  "data-product-buy"?: boolean | string;
}

const {
  href,
  title,
  class: className,
  target,
  rel,
  external,
  centered = false,
  eventName,
  "data-product-buy": dataProductBuy,
} = Astro.props;

const isExternal = external ?? /^(https?:)?\/\//.test(href);
const resolvedTarget = target ?? (isExternal ? "_blank" : undefined);
const resolvedRel =
  rel ?? (resolvedTarget === "_blank" ? "noopener noreferrer" : undefined);
const iconName = isExternal ? "ph:arrow-up-right" : "ph:arrow-right";
---

<div class:list={[centered ? "my-8 text-center" : "contents"]}>
  <a
    href={href}
    title={title}
    target={resolvedTarget}
    rel={resolvedRel}
    data-umami-event={eventName}
    data-product-buy={dataProductBuy}
    class:list={[
      "cta-link group relative inline-flex max-w-full h-[calc(48px+8px)] items-center justify-center rounded-full bg-neutral-950 py-1 pl-6 pr-14 text-white no-underline transition-all hover:text-white",
      className,
    ]}
  >
    <span class="z-10 pr-2"><slot /></span>
    <span
      class="absolute right-1 inline-flex h-12 w-12 items-center justify-end rounded-full bg-primary-700 transition-[width] duration-300 ease-in-out group-hover:w-[calc(100%-8px)]"
      aria-hidden="true"
    >
      <span class="mr-3.5 flex items-center justify-center">
        <Icon name={iconName} class="h-5 w-5 text-primary-50" aria-hidden="true" />
      </span>
    </span>
    {
      resolvedTarget === "_blank" && (
        <span class="sr-only"> (se abre en una pestaña nueva)</span>
      )
    }
  </a>
</div>
