---
import { Icon } from "astro-icon/components";

export interface ProductVariant {
  id: string;
  label: string;
  price: string;
  compareAtPrice?: string;
  paymentLink: string;
}

export interface ProductImage {
  src: string;
  alt: string;
}

interface Props {
  id: string;
  name: string;
  description: string;
  images: ProductImage[];
  variants: ProductVariant[];
}

const { id, name, description, images, variants } = Astro.props as Props;

if (variants.length === 0) {
  throw new Error("ProductoCuadro requiere al menos una variante");
}

if (images.length === 0) {
  throw new Error("ProductoCuadro requiere al menos una imagen");
}

const defaultVariant = variants[0];
---

<article data-product>
  <div class="grid items-start gap-8 lg:grid-cols-2 lg:gap-12">
  <div data-product-slider>
    <div class="relative">
    <div class="w-full overflow-hidden rounded-2xl" data-slider-viewport>
      <div class="flex w-full transition-transform duration-300 ease-out" data-slider-track>
        {
          images.map((image, index) => (
            <div class="w-full shrink-0 grow-0 basis-full" data-slider-slide>
              <button
                type="button"
                class="group relative block h-full w-full cursor-zoom-in overflow-hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
                data-lightbox-open
                data-image-index={index}
                aria-label={`Ver imagen ampliada ${index + 1} de ${images.length}`}
              >
                <img
                  src={image.src}
                  alt={image.alt}
                  width="1236"
                  height="864"
                  class="h-72 w-full object-cover sm:h-96 lg:h-[28rem]"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  data-lightbox-src={image.src}
                />
                <span
                  class="pointer-events-none absolute inset-0 bg-black/0 transition-colors group-hover:bg-black/15"
                  aria-hidden="true"
                ></span>
              </button>
            </div>
          ))
        }
      </div>
    </div>

    {
      images.length > 1 && (
        <>
          <button
            type="button"
            class="absolute top-1/2 left-2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-emerald-800 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
            data-slider-prev
            aria-label="Imagen anterior"
          >
            <Icon name="ph:arrow-left" class="h-[18px] w-[18px]" aria-hidden="true" />
          </button>
          <button
            type="button"
            class="absolute top-1/2 right-2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-emerald-800 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
            data-slider-next
            aria-label="Imagen siguiente"
          >
            <Icon name="ph:arrow-right" class="h-[18px] w-[18px]" aria-hidden="true" />
          </button>
        </>
      )
    }
    </div>

    {
      images.length > 1 && (
        <div class="mt-3 flex justify-center gap-2" role="tablist" aria-label="Imágenes del producto">
          {images.map((_, index) => (
            <button
              type="button"
              class="h-2.5 w-2.5 rounded-full bg-gray-300 aria-[current=true]:bg-primary-700"
              data-slider-dot
              aria-label={`Ver imagen ${index + 1}`}
              aria-current={index === 0 ? "true" : undefined}
            />
          ))}
        </div>
      )
    }
  </div>

  <div>
    <h2 class="mb-4 text-3xl text-emerald-800 text-balance">{name}</h2>
    <p class="mb-7 leading-7 text-gray-700">{description}</p>

    <fieldset class="mb-6">
      <legend class="mb-3 font-semibold text-gray-900">Elige el tamaño</legend>
      <div class="flex flex-wrap gap-3">
        {
          variants.map((variant, index) => (
            <div>
              <input
                class="peer sr-only"
                type="radio"
                id={`${id}-${variant.id}`}
                name={`${id}-size`}
                value={variant.id}
                data-product-variant
                data-price={variant.price}
                data-compare-at-price={variant.compareAtPrice ?? ""}
                data-payment-link={variant.paymentLink}
                checked={index === 0}
              />
              <label
                for={`${id}-${variant.id}`}
                class="inline-flex min-h-12 cursor-pointer items-center justify-center rounded-full border-2 border-gray-300 bg-white px-5 py-2 font-semibold text-gray-800 transition-colors hover:border-primary-500 peer-checked:border-primary-700 peer-checked:bg-primary-50 peer-checked:text-primary-800 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary-500"
              >
                {variant.label}
              </label>
            </div>
          ))
        }
      </div>
    </fieldset>

    <div aria-live="polite" aria-atomic="true" class="mb-5">
      <div class="flex flex-wrap items-end gap-x-3 gap-y-1">
        {
          defaultVariant.compareAtPrice && (
            <p
              class="mb-0 text-lg text-gray-500 line-through"
              data-product-compare
            >
              {defaultVariant.compareAtPrice}
            </p>
          )
        }
        <p class="mb-0 text-3xl font-bold text-emerald-900" data-product-price>
          {defaultVariant.price}
        </p>
        {
          defaultVariant.compareAtPrice && (
            <span
              class="mb-1 inline-flex rounded-full bg-primary-100 px-2.5 py-0.5 text-sm font-semibold text-primary-800"
              data-product-offer
            >
              Oferta
            </span>
          )
        }
      </div>
      <p class="mb-0 text-sm text-gray-600">IVA incluido</p>
    </div>

    <a
      href={defaultVariant.paymentLink}
      target="_blank"
      rel="noopener noreferrer"
      title="Comprar el cuadro El Faedo de Ciñera"
      class="group font-wittgenstein relative inline-flex h-[calc(48px+8px)] items-center justify-center rounded-full bg-neutral-950 py-1 pl-6 pr-14 font-medium text-white no-underline transition-all"
      data-product-buy
      data-umami-event="tienda-compra-click"
    >
      <span class="z-10 pr-2">Comprar</span>
      <div
        class="absolute right-1 inline-flex h-12 w-12 items-center justify-end rounded-full bg-primary-700 transition-[width] duration-300 ease-in-out group-hover:w-[calc(100%-8px)]"
        aria-hidden="true"
      >
          <div class="mr-3.5 flex items-center justify-center">
            <Icon name="ph:arrow-right" class="h-5 w-5 text-primary-50" aria-hidden="true" />
          </div>
      </div>
    </a>

    <ul
      class="mt-4 mb-0 flex flex-wrap items-center gap-2 sm:justify-start justify-center"
      aria-label="Métodos de pago aceptados"
    >
      {
        [
          { src: "/pagos/visa.svg", alt: "Visa" },
          { src: "/pagos/mastercard.svg", alt: "Mastercard" },
          { src: "/pagos/amex.svg", alt: "American Express" },
          { src: "/pagos/apple-pay.svg", alt: "Apple Pay" },
          { src: "/pagos/google-pay.svg", alt: "Google Pay" },
        ].map((method) => (
          <li>
            <img
              src={method.src}
              alt={method.alt}
              width="38"
              height="24"
              class="h-8 w-auto border border-gray-200 bg-white"
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>

    <p class="mt-3 mb-0 flex flex-wrap items-center justify-center gap-x-1.5 gap-y-1 text-sm leading-6 text-gray-600 sm:justify-start">
      <span>Envío en 4-8 días laborables · Impresión bajo pedido · Pago seguro con</span>
      <img
        src="/pagos/stripe.svg"
        alt="Stripe"
        width="46"
        height="24"
        class="inline-block h-5 w-auto border border-gray-200 bg-white"
        loading="lazy"
      />
    </p>
  </div>
  </div>

  <div
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/95 p-2 sm:p-4"
    data-product-lightbox
    role="dialog"
    aria-modal="true"
    aria-label="Visor de imágenes del producto"
  >
    <button
      type="button"
      class="absolute top-2 right-2 rounded-full p-2 text-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:top-4 sm:right-4"
      data-lightbox-close
      aria-label="Cerrar visor de imágenes"
    >
      <Icon name="ph:x" class="h-7 w-7" aria-hidden="true" />
    </button>

    {
      images.length > 1 && (
        <>
          <button
            type="button"
            class="absolute top-1/2 left-2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:left-4"
            data-lightbox-prev
            aria-label="Imagen anterior"
          >
            <Icon name="ph:caret-left" class="h-7 w-7" aria-hidden="true" />
          </button>
          <button
            type="button"
            class="absolute top-1/2 right-2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:right-4"
            data-lightbox-next
            aria-label="Imagen siguiente"
          >
            <Icon name="ph:caret-right" class="h-7 w-7" aria-hidden="true" />
          </button>
        </>
      )
    }

    <div class="flex h-full max-h-[90vh] w-full max-w-7xl items-center justify-center">
      <img
        src={images[0].src}
        alt={images[0].alt}
        class="max-h-full max-w-full rounded-lg object-contain"
        data-lightbox-image
      />
    </div>

    {
      images.length > 1 && (
        <div class="absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-black/50 px-4 py-2 text-sm text-white">
          <span data-lightbox-counter aria-live="polite">1 / {images.length}</span>
        </div>
      )
    }
  </div>
</article>

<script>
  function initializeProducts() {
    document.querySelectorAll<HTMLElement>("[data-product]").forEach((product) => {
      if (product.dataset.initialized === "true") return;

      const price = product.querySelector<HTMLElement>("[data-product-price]");
      const compareAt = product.querySelector<HTMLElement>("[data-product-compare]");
      const offerBadge = product.querySelector<HTMLElement>("[data-product-offer]");
      const buyLink = product.querySelector<HTMLAnchorElement>("[data-product-buy]");
      const variants =
        product.querySelectorAll<HTMLInputElement>("[data-product-variant]");

      variants.forEach((variant) => {
        variant.addEventListener("change", () => {
          if (!variant.checked || !price || !buyLink) return;

          price.textContent = variant.dataset.price ?? "";
          buyLink.href = variant.dataset.paymentLink ?? "";

          const previousPrice = variant.dataset.compareAtPrice ?? "";
          if (compareAt) {
            compareAt.textContent = previousPrice;
            compareAt.hidden = previousPrice.length === 0;
          }
          if (offerBadge) {
            offerBadge.hidden = previousPrice.length === 0;
          }
        });
      });

      const slider = product.querySelector<HTMLElement>("[data-product-slider]");
      const viewport = slider?.querySelector<HTMLElement>("[data-slider-viewport]");
      const track = slider?.querySelector<HTMLElement>("[data-slider-track]");
      const slides = slider?.querySelectorAll("[data-slider-slide]") ?? [];
      const dots = slider?.querySelectorAll<HTMLButtonElement>("[data-slider-dot]") ?? [];
      const prev = slider?.querySelector<HTMLButtonElement>("[data-slider-prev]");
      const next = slider?.querySelector<HTMLButtonElement>("[data-slider-next]");
      const openButtons =
        product.querySelectorAll<HTMLButtonElement>("[data-lightbox-open]");
      const lightbox = product.querySelector<HTMLElement>("[data-product-lightbox]");
      const lightboxImage =
        product.querySelector<HTMLImageElement>("[data-lightbox-image]");
      const lightboxCounter =
        product.querySelector<HTMLElement>("[data-lightbox-counter]");
      const lightboxClose =
        product.querySelector<HTMLButtonElement>("[data-lightbox-close]");
      const lightboxPrev =
        product.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
      const lightboxNext =
        product.querySelector<HTMLButtonElement>("[data-lightbox-next]");

      const gallery = Array.from(openButtons).map((button) => {
        const img = button.querySelector("img");
        return {
          src: img?.dataset.lightboxSrc || img?.src || "",
          alt: img?.alt || "",
        };
      });

      let index = 0;
      let lightboxIndex = 0;
      let lightboxOpen = false;

      const goTo = (nextIndex: number) => {
        if (!track || !viewport || slides.length === 0) return;

        index = (nextIndex + slides.length) % slides.length;
        const offset = viewport.clientWidth * index;
        track.style.transform = `translateX(-${offset}px)`;
        dots.forEach((dot, dotIndex) => {
          if (dotIndex === index) {
            dot.setAttribute("aria-current", "true");
          } else {
            dot.removeAttribute("aria-current");
          }
        });
      };

      const updateLightbox = () => {
        if (!lightboxImage || gallery.length === 0) return;

        lightboxImage.src = gallery[lightboxIndex].src;
        lightboxImage.alt = gallery[lightboxIndex].alt;
        if (lightboxCounter) {
          lightboxCounter.textContent = `${lightboxIndex + 1} / ${gallery.length}`;
        }
      };

      const openLightbox = (nextIndex: number) => {
        if (!lightbox || gallery.length === 0) return;

        lightboxIndex = (nextIndex + gallery.length) % gallery.length;
        updateLightbox();
        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
        document.body.style.overflow = "hidden";
        lightboxOpen = true;
        setTimeout(() => lightboxClose?.focus(), 100);
      };

      const closeLightbox = () => {
        if (!lightbox) return;

        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        document.body.style.overflow = "";
        lightboxOpen = false;
        openButtons[lightboxIndex]?.focus();
      };

      const showLightboxPrev = () => {
        if (gallery.length === 0) return;
        lightboxIndex = (lightboxIndex - 1 + gallery.length) % gallery.length;
        updateLightbox();
        goTo(lightboxIndex);
      };

      const showLightboxNext = () => {
        if (gallery.length === 0) return;
        lightboxIndex = (lightboxIndex + 1) % gallery.length;
        updateLightbox();
        goTo(lightboxIndex);
      };

      prev?.addEventListener("click", () => goTo(index - 1));
      next?.addEventListener("click", () => goTo(index + 1));
      dots.forEach((dot, dotIndex) => {
        dot.addEventListener("click", () => goTo(dotIndex));
      });
      window.addEventListener("resize", () => goTo(index));

      openButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const imageIndex = Number(button.dataset.imageIndex ?? index);
          openLightbox(imageIndex);
        });
      });

      lightboxClose?.addEventListener("click", closeLightbox);
      lightboxPrev?.addEventListener("click", showLightboxPrev);
      lightboxNext?.addEventListener("click", showLightboxNext);
      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });

      document.addEventListener("keydown", (event) => {
        if (!lightboxOpen) return;

        if (event.key === "Escape") closeLightbox();
        if (event.key === "ArrowLeft") showLightboxPrev();
        if (event.key === "ArrowRight") showLightboxNext();
      });

      product.dataset.initialized = "true";
    });
  }

  initializeProducts();
  document.addEventListener("astro:page-load", initializeProducts);
</script>
