---
import { Icon } from "astro-icon/components";
import imageTopo from "@assets/topo.svg";
---

<div class="topo" style={`background-image: url(${imageTopo.src});`}>
  <div class="max-w-xl mx-auto px-4">
    <h3 class="text-4xl font-bold mb-2">Visita guiada al Faedo de Ciñera</h3>
    <p class="text-lg">
      Si deseas conocer más sobre el Faedo de Ciñera, contrata un tour guiado. Pulsa el siguiente botón y envía un mensaje por WhatsApp y hazlo ahora.
    </p>

    <a
      href="https://wa.me/34649131791?text=Me%20gustaría%20contratar%20una%20visita%20guiada%20al%20Faedo%20de%20Ciñera"
      target="_blank"
      title="Reserva tu tour guiado al Faedo de Ciñera por WhatsApp"
      rel="noopener noreferrer"
      data-umami-event="visita-guiada-click"
      class="group font-wittgenstein relative inline-flex h-[calc(48px+8px)] items-center justify-center rounded-full bg-neutral-950 py-1 pl-6 pr-14 font-medium text-white transition-all mt-8"
    >
      <span class="z-10 pr-2">Reserva tu tour guiado</span>
      <div
        class="absolute right-1 inline-flex h-12 w-12 items-center justify-end rounded-full bg-primary-700 transition-[width] duration-300 ease-in-out group-hover:w-[calc(100%-8px)]"
      >
        <div class="mr-3.5 flex items-center justify-center">
          <Icon name="ph:arrow-right" class="h-5 w-5 text-primary-50" aria-hidden="true" />
        </div>
      </div>
    </a>
  </div>
</div>

<style>
  .topo {
    background-color: var(--color-emerald-500);
    background-position: center center;
    background-size: cover;
    background-repeat: no-repeat;
    padding: calc(var(--spacing) * 24) calc(var(--spacing) * 4);
    color: var(--color-white);
    text-align: center;
  }
</style>
