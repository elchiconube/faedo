---
interface Props {
  href: string;
  subtitle?: string;
}

const { href, subtitle } = Astro.props;

const icon =
  "M232,48H160a40,40,0,0,0-32,16A40,40,0,0,0,96,48H24a8,8,0,0,0-8,8V200a8,8,0,0,0,8,8H96a24,24,0,0,1,24,24,8,8,0,0,0,16,0,24,24,0,0,1,24-24h72a8,8,0,0,0,8-8V56A8,8,0,0,0,232,48ZM96,192H32V64H96a24,24,0,0,1,24,24V200A39.81,39.81,0,0,0,96,192Zm128,0H160a39.81,39.81,0,0,0-24,8V88a24,24,0,0,1,24-24h64ZM160,88h40a8,8,0,0,1,0,16H160a8,8,0,0,1,0-16Zm48,40a8,8,0,0,1-8,8H160a8,8,0,0,1,0-16h40A8,8,0,0,1,208,128Zm0,32a8,8,0,0,1-8,8H160a8,8,0,0,1,0-16h40A8,8,0,0,1,208,160Z";
---

<a
  href={href}
  class="flex w-fit max-w-full items-center gap-2 mx-auto my-8 text-center bg-emerald-50 border border-emerald-200 hover:bg-emerald-100 transition rounded-xl py-3 px-4 text-emerald-800 font-medium shadow-sm no-underline"
>
  <svg
    class="shrink-0"
    width="20"
    height="20"
    fill="currentColor"
    viewBox="0 0 256 256"
    aria-hidden="true"
  >
    <path d={icon}></path>
  </svg>
  <span class="min-w-0">
    <slot />
    {
      subtitle && (
        <span class="block text-sm opacity-75 font-normal">{subtitle}</span>
      )
    }
  </span>
</a>
