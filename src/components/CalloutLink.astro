---
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  subtitle?: string;
}

const { href, subtitle } = Astro.props;
---

<a
  href={href}
  class="flex w-fit max-w-full items-center gap-2 mx-auto my-8 text-center bg-emerald-50 border border-emerald-200 hover:bg-emerald-100 transition rounded-xl py-3 px-4 text-emerald-800 font-medium no-underline"
>
  <Icon name="ph:books" class="h-5 w-5 shrink-0" aria-hidden="true" />
  <span class="min-w-0">
    <slot />
    {
      subtitle && (
        <span class="block text-sm opacity-75 font-normal">{subtitle}</span>
      )
    }
  </span>
</a>
