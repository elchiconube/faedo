---
interface Props {
  class?: string;
  /** Añade max-w-4xl mx-auto py-8 px-4 (por defecto true) */
  padded?: boolean;
}

const { class: className, padded = true } = Astro.props;
---

<div
  class:list={[
    "content",
    padded && "mx-auto max-w-4xl px-4 py-8",
    "[&_section]:mb-8",
    "[&>h2]:mt-8 [&>h2]:mb-2.5 [&>h2]:text-balance [&>h2]:text-3xl [&>h2]:font-semibold [&>h2]:text-emerald-800",
    "[&_section>h2]:mt-8 [&_section>h2]:mb-2.5 [&_section>h2]:text-balance [&_section>h2]:text-3xl [&_section>h2]:font-semibold [&_section>h2]:text-emerald-800",
    "[&>h3]:mt-8 [&>h3]:mb-2.5 [&>h3]:text-balance [&>h3]:text-2xl [&>h3]:font-semibold [&>h3]:text-emerald-800",
    "[&_section>h3]:mt-8 [&_section>h3]:mb-2.5 [&_section>h3]:text-balance [&_section>h3]:text-2xl [&_section>h3]:font-semibold [&_section>h3]:text-emerald-800",
    "[&_a:not(.cta-link)]:font-bold [&_a:not(.cta-link)]:text-primary-700 [&_a:not(.cta-link)]:underline [&_a:not(.cta-link)]:underline-offset-2",
    "[&_a:not(.cta-link)]:focus-visible:outline [&_a:not(.cta-link)]:focus-visible:outline-2 [&_a:not(.cta-link)]:focus-visible:outline-offset-2 [&_a:not(.cta-link)]:focus-visible:outline-primary-400",
    className,
  ]}
>
  <slot />
</div>
