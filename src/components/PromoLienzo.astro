---
import { Icon } from "astro-icon/components";

interface Props {
  title?: string;
  description?: string;
  ctaLabel?: string;
  href?: string;
  imageSrc?: string;
  imageAlt?: string;
  badge?: string;
}

const {
  title = "Lleva el Faedo a casa",
  description = "Disfruta del Faedo de Ciñera en tu casa. Hemos hecho un lienzo precioso con el que podrás recordar tu visita. Quedará genial en el rincón que decidas ponerlo. Aprovecha la oferta que tenemos disponible por tiempo limitado.",
  ctaLabel = "Ver oferta en la tienda",
  href = "/tienda",
  imageSrc = "/cuadros/cuado-faedo-1.jpeg",
  imageAlt = "Mockup del cuadro El Faedo de Ciñera en lienzo",
  badge = "Oferta especial",
} = Astro.props;
---

<section
  class="my-6 border-y border-primary-200 bg-primary-50 px-4 py-12 sm:py-16"
  aria-labelledby="promo-lienzo-title"
>
  <div class="mx-auto grid max-w-6xl items-center gap-8 lg:grid-cols-2 lg:gap-12">
    <a
      href={href}
      title={ctaLabel}
      class="block overflow-hidden rounded-2xl no-underline"
      data-umami-event="promo-lienzo-click"
    >
      <img
        src={imageSrc}
        alt={imageAlt}
        width="1236"
        height="864"
        class="h-64 w-full object-cover transition-transform duration-300 hover:scale-105 sm:h-80 lg:h-[22rem]"
        loading="lazy"
        decoding="async"
      />
    </a>

    <div>
      {
        badge && (
          <p class="mb-3 inline-flex rounded-full bg-white px-3 py-1 text-sm font-semibold text-primary-800">
            {badge}
          </p>
        )
      }
      <h2
        id="promo-lienzo-title"
        class="mb-3 text-3xl text-emerald-800 text-balance"
      >
        {title}
      </h2>
      <p class="mb-7 max-w-xl leading-7 text-gray-700">
        {description}
      </p>
      <a
        href={href}
        title={ctaLabel}
        class="group font-wittgenstein relative inline-flex h-[calc(48px+8px)] items-center justify-center rounded-full bg-neutral-950 py-1 pl-6 pr-14 font-medium text-white no-underline transition-all"
        data-umami-event="promo-lienzo-click"
      >
        <span class="z-10 pr-2">{ctaLabel}</span>
        <div
          class="absolute right-1 inline-flex h-12 w-12 items-center justify-end rounded-full bg-primary-700 transition-[width] duration-300 ease-in-out group-hover:w-[calc(100%-8px)]"
          aria-hidden="true"
        >
          <div class="mr-3.5 flex items-center justify-center">
            <Icon name="ph:arrow-right" class="h-5 w-5 text-primary-50" aria-hidden="true" />
          </div>
        </div>
      </a>
    </div>
  </div>
</section>
