---
import { Icon } from "astro-icon/components";
import { getCardsByIds, getCardsForPath } from "@data/cards";

interface Props {
  ids: string[];
  titleTag?: "h2" | "h3" | "h4";
  /** Si es false, no filtra la URL actual (por defecto sí filtra) */
  excludeCurrent?: boolean;
  limit?: number;
}

const { ids, titleTag, excludeCurrent = true, limit = 4 } = Astro.props;

const cards = excludeCurrent
  ? getCardsForPath(Astro.url.pathname, ids, limit)
  : getCardsByIds(ids).slice(0, limit);
---

<style>
  .card-image {
    transition: none;
  }

  @media (min-width: 768px) {
    .card-image {
      transition: transform 0.4s ease;
    }

    .card-link:hover .card-image {
      transform: scale(1.05);
    }
  }
</style>

{
  cards.map((card) => {
    const TitleTag = titleTag || "h3";
    const tooltip = card.description
      ? `${card.title}: ${card.description}`
      : card.title;
    return (
      <a
        class:list={[
          "card-link block p-4 rounded-xl  no-underline aspect-square relative overflow-hidden flex flex-col justify-end",
          !card.backgroundImage &&
            "bg-gradient-to-tr from-emerald-500 to-emerald-600",
        ]}
        href={card.href}
        title={tooltip}
      >
        {card.backgroundImage && (
          <img
            src={card.backgroundImage}
            alt=""
            class="card-image absolute inset-0 w-full h-full object-cover"
            aria-hidden="true"
          />
        )}

        <div class="absolute inset-0 z-0" aria-hidden="true">
          <div class="absolute inset-0 bg-black/20" />
        </div>

        {card.icon && (
          <div
            class="absolute top-3 right-3 bg-white/20 p-2 rounded-full text-white backdrop-blur-sm"
            aria-hidden="true"
          >
            <Icon name={card.icon} class="h-6 w-6" />
          </div>
        )}

        <div class="relative z-10">
          <TitleTag class="font-bold text-white text-2xl">
            {card.title}
          </TitleTag>
          {card.description && (
            <p class="text-m text-white mt-1 font-semibold mr-12">
              {card.description}
            </p>
          )}
        </div>
      </a>
    );
  })
}
