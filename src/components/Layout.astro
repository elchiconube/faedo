---
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_LOCALE,
  SITE_LOGO,
} from "../consts";
import GoogleAnalytics from "./GoogleAnalytics.astro";
import GoogleSiteVerification from "./GoogleSiteVerification.astro";
import UmamiAnalytics from "./UmamiAnalytics.astro";
import { ClientRouter } from "astro:transitions";
import { Icon } from "astro-icon/components";
import "../styles/globals.css";
import Guia from "./Guia.astro";
import GoogleReviews from "./GoogleReviews.astro";
import { Image } from "astro:assets";
import logoFaedoDigital from "@assets/logo-faedo-digital.webp";
import Seo from "./Seo.astro";

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  url = undefined,
  image = undefined,
  type = "website",
  robots = undefined,
  canonical = true,
  jsonLd = undefined,
  showFooterContent = true,
} = Astro.props;

// Navegación principal
const navItems = [
  {
    href: "/",
    label: "Inicio",
    title: "Ir a la página de inicio del Faedo de Ciñera",
  },
  {
    href: "/ruta/faedo-de-cinera",
    label: "La ruta",
    title: "Guía completa de la ruta del Faedo: mapa, GPX y consejos",
  },
  {
    href: "/pozo-ibarra",
    label: "Pozo Ibarra",
    title: "Historia y patrimonio del Pozo Ibarra en Ciñera",
  },
  {
    href: "/guia-visitantes",
    label: "Guía",
    title: "Guía para visitantes: alojamientos, servicios e itinerarios",
  },
  {
    href: "/tienda",
    label: "Tienda",
    title: "Tienda del Faedo de Ciñera: artículos y recuerdos",
  },
  {
    href: "/historia-naturaleza",
    label: "Descubre",
    title: "Historia y naturaleza del Faedo de Ciñera",
  },
  {
    href: "/blog",
    label: "Blog",
    title: "Artículos y novedades sobre el Faedo de Ciñera",
  },
  {
    href: "/faq",
    label: "FAQ",
    title: "Preguntas frecuentes sobre la ruta del Faedo",
  },
];
---

<!doctype html>
<html lang={SITE_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#349981" />
    <Seo
      title={title}
      description={description}
      url={url}
      image={image}
      type={type}
      robots={robots}
      canonical={canonical}
      jsonLd={jsonLd}
    />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Faedo" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- DNS Prefetch para recursos externos -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://umami.faedodigital.com" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href="/rss.xml"
    />
    <!-- Google Fonts - Wittgenstein & Figtree -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Wittgenstein:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.setAttribute('media', 'all')"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Wittgenstein:ital,wght@0,400..900;1,400..900&display=swap"
        rel="stylesheet"
      />
    </noscript>
    {canonical && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "WebSite",
          name: SITE_NAME,
          description: SITE_DESCRIPTION,
          url: Astro.site?.toString(),
          inLanguage: SITE_LOCALE,
        })}
      />
    )}
    <slot name="head" />
    <GoogleSiteVerification />
    <GoogleAnalytics />
    <UmamiAnalytics />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header
      class="border-b border-gray-300 sticky top-0 bg-white/80 backdrop-blur-sm z-50"
      transition:persist
    >
      <nav
        class="container flex items-center justify-between"
        aria-label="Principal"
      >
        <a
          href="/"
          class="font-wittgenstein text-xl text-primary-700 no-underline inline-flex items-center gap-2 py-2"
          title="Ir a la página de inicio del Faedo de Ciñera"
        >
          <img
            src={SITE_LOGO}
            alt=""
            width="40"
            height="40"
            class="h-10 w-10"
          />
          <span>{SITE_NAME}</span>
        </a>

        <!-- Menú desktop -->
        <ul class="hidden md:flex font-wittgenstein">
          {
            navItems.map((item) => (
              <li>
                <a
                  class="px-2 py-6 inline-block"
                  href={item.href}
                  title={item.title}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <!-- Botón hamburguesa móvil -->
        <button
          id="menu-toggle"
          class="md:hidden my-4 p-2 text-gray-700 hover:text-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-400 rounded"
          aria-label="Abrir menú"
          aria-expanded="false"
        >
          <Icon name="ph:list" class="h-6 w-6" aria-hidden="true" />
        </button>
      </nav>

      <!-- Menú móvil -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100">
        <ul
          class="container font-wittgenstein py-4 flex flex-col gap-3 text-center"
        >
          {
            navItems.map((item, index) => (
              <li>
                <a
                  href={item.href}
                  title={item.title}
                  class={`block py-2 ${index < navItems.length - 1 ? "border-b border-gray-100" : ""}`}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <script>
      // Toggle menú móvil
      const menuToggle = document.getElementById("menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");

      menuToggle?.addEventListener("click", () => {
        const isOpen = mobileMenu?.classList.toggle("hidden");
        menuToggle.setAttribute("aria-expanded", isOpen ? "false" : "true");
      });

      // Cerrar menú al hacer clic en un enlace
      mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
          menuToggle?.setAttribute("aria-expanded", "false");
        });
      });

      // Cerrar menú al cambiar de tamaño a desktop
      window.addEventListener("resize", () => {
        if (window.innerWidth >= 768) {
          mobileMenu?.classList.add("hidden");
          menuToggle?.setAttribute("aria-expanded", "false");
        }
      });
    </script>
    <main id="contenido" class="flex-1">
      <slot />
    </main>

    {showFooterContent && <GoogleReviews />}
    {showFooterContent && <Guia />}

    <footer class="border-t border-gray-100" transition:persist>
      <div
        class="container py-8 text-sm flex flex-col gap-2 md:flex-row md:items-center md:justify-between"
      >
        <p class="text-center md:text-left">
          &copy; {new Date().getFullYear()}{' '}{SITE_NAME}
        </p>
        <nav aria-label="Secundario">
          <ul class="md:flex md:gap-4 font-wittgenstein text-center">
            {
              navItems.map((item) => (
                <li>
                  <a
                    class="text-base py-2 inline-block"
                    href={item.href}
                    title={item.title}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <div class="container pb-4">
        <p class="text-xs text-gray-500 text-center max-w-3xl mx-auto py-2">
          Como participante del Programa de Afiliados de Amazon, faedo.es obtiene
          ingresos por las compras adscritas que cumplen los requisitos aplicables.
        </p>
      </div>
      <div class="footer-faedo flex justify-center py-6">
        <a
          href="https://faedodigital.com/"
          target="_blank"
          rel="noopener noreferrer"
          title="Sitio web creado y mantenido por Faedo Digital"
        >
          <Image
            src={logoFaedoDigital}
            alt="Faedo Digital"
            width={180}
            height={45}
          />
        </a>
      </div>
    </footer>
  </body>
</html>
